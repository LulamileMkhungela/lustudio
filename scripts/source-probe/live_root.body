<script>
(function(){
 function run(){
  var root=document.querySelector('[data-rtk]'); if(!root||root.getAttribute('data-rtk')==='on') return; root.setAttribute('data-rtk','on');
  var track=root.querySelector('[data-rtk-track]'), more=root.querySelector('[data-rtk-more]');
  var src=document.getElementById('lt-rv');
  function txt(el){return el?el.textContent.replace(/\s+/g,' ').trim():'';}
  function esc(s){return s.replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
  var items=[];
  if(src){
    src.querySelectorAll('article.lt-p').forEach(function(a){
      var q=txt(a.querySelector('.lt-q')).replace(/^[“"]|[”"]$/g,'');
      var name=txt(a.querySelector('cite')); if(!q||!name||/\s(team|client)$/i.test(name)) return;
      var role=txt(a.querySelector('.lt-sg cite + span, .lt-sg div > span'));
      var ph=a.querySelector('img.lt-ph');
      var pl=a.querySelector('.lt-pl img'); var site=pl?(pl.getAttribute('alt')||''):'';
      var vr=a.querySelectorAll('.lt-vr > span'); var d=vr.length?txt(vr[vr.length-1]):'';
      var when=d.replace(/\bPresent\b/,'ongoing');
      items.push({q:q,name:name,role:role,img:ph?ph.currentSrc||ph.src:'',ts:[site,when].filter(Boolean).join(' · ')});
    });
  }
  if(!items.length){ root.querySelector('.rtk-vp').style.display='none'; more.setAttribute('href','/reviews'); return; }
  function card(it,hide){
    var av=it.img?'<img class="rtk-av" src="'+esc(it.img)+'" alt="" loading="lazy" width="36" height="36">'
      :'<span class="rtk-av" aria-hidden="true">'+esc(it.name.split(' ').map(function(w){return w[0];}).slice(0,2).join('').toUpperCase())+'</span>';
    return '<figure class="rtk-it"'+(hide?' aria-hidden="true"':'')+'>'+av+'<div class="rtk-bb"><figcaption class="rtk-who"><b>'+esc(it.name)+'</b>'+(it.role?'<span>'+esc(it.role)+'</span>':'')+'</figcaption><blockquote class="rtk-q">'+esc(it.q)+'</blockquote>'+(it.ts?'<div class="rtk-ts">'+esc(it.ts)+'</div>':'')+'</div></figure>';
  }
  track.innerHTML=items.map(function(i){return card(i,false);}).join('')+items.map(function(i){return card(i,true);}).join('');
  track.style.setProperty('--rtk-d',(items.length*5)+'s');
  var vp=root.querySelector('.rtk-vp'); vp.addEventListener('click',function(){vp.classList.toggle('is-paused');});
  more.addEventListener('click',function(e){
    var t=document.getElementById('lt-rv'); if(!t) return; e.preventDefault();
    t=t.closest('section')||t; var off=0;
    var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({top:t.getBoundingClientRect().top+window.pageYOffset-off,behavior:reduce?'auto':'smooth'});
    if(history.replaceState) history.replaceState(null,'','#lt-rv');
  });
 }
 if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else run();
})();
</script></div></div></div><div class="spacer-xlarge is-mobile-medium"></div><div data-awards-head=""><div class="text-color-grey-300"><div class="text-style-label-caption">Awards</div></div><div class="spacer-small"></div><h2 class="heading-style-h3">Recognized by the world’s top design juries</h2><div class="spacer-large"></div></div></div></div><div class="clients_logos"><div class="brands_card-group"><div class="clients_brand-card"><div class="clients_card"><div aria-hidden="true" class="clients_number">(01)</div><img src="/assets/img/logo.svg" loading="lazy" alt="TheFWA logo" class="clients_logo"/></div><div class="clients_texts"><div class="clients_name">TheFWA</div><p class="clients_desc">3× FWA of the Day</p></div></div><div class="clients_brand-card"><div class="clients_card"><div aria-hidden="true" class="clients_number">(02)</div><img src="/assets/img/logo-1.svg" loading="lazy" alt="Awwwards logo" class="clients_logo"/></div><div class="clients_texts"><div class="clients_name">Awwwards</div><p class="clients_desc">18 awards. 4× Site of the Day</p></div></div><div class="clients_brand-card"><div class="clients_card"><div aria-hidden="true" class="clients_number">(03)</div><img src="/assets/img/logo-2.svg" loading="lazy" alt="CSS Design Awards logo" class="clients_logo"/></div><div class="clients_texts"><div class="clients_name">CSS DA</div><p class="clients_desc">25× UI, UX, Innovation</p></div></div><div class="clients_brand-card"><div class="clients_card"><div aria-hidden="true" class="clients_number">(04)</div><img src="/assets/img/logo-3.svg" loading="lazy" alt="Orpetron logo" class="clients_logo"/></div><div class="clients_texts"><div class="clients_name">Orpetron</div><p class="clients_desc">4× SOTD, SOTM, OWDA</p></div></div><div class="clients_brand-card"><div class="clients_card"><div aria-hidden="true" class="clients_number">(05)</div><img src="/assets/img/logo-4.svg" loading="lazy" alt="Red Dot Award logo" class="clients_logo"/></div><div class=