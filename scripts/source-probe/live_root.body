html :is(.section_testimonials.lt-dark,.home-grid_team,.cta_component,.awards_component,.section_pricing,.tab_component,.header-about_cube,.number-card:not(.is-light),.features_timeline,.home-grid_chat,.pricing_plans,.pricing_infos,.ct-card.is-dark,.calc_sum,.dx-fitcard.is-yes,.dx-tab-panel,.dx-case,.dx-panel) a.button:not([data-cc-glow])>.button-in{background-color:#151718!important;color:#fff!important}
}
/* both themes: Anna card has a neutral border, gradient only on the button */
html body .cs-ask.cs-gb,html body :has(> [data-anna-box]){background-image:linear-gradient(var(--_colors---primary--white),var(--_colors---primary--white)),linear-gradient(var(--_colors---grey--100),var(--_colors---grey--100))!important}
/* both themes: readable secondary grey text inside dark sections (WCAG 4.5:1) */
html :is(.section_testimonials.lt-dark,.home-grid_team,.cta_component,.awards_component,.section_pricing,.tab_component,.header-about_cube,.number-card:not(.is-light),.features_timeline,.home-grid_chat,.pricing_plans,.pricing_infos,.ct-card.is-dark,.calc_sum){--_colors---grey--300:#8a8a8a;--_colors---grey--400:#8a8a8a}
/* both themes: links in articles are clearly underlined */
html .w-richtext :is(p,li,td,th,blockquote) a:not([class]){text-decoration-line:underline;text-decoration-thickness:1px;text-underline-offset:3px;text-decoration-color:color-mix(in srgb,currentColor 55%,transparent)}
html .w-richtext :is(p,li,td,th,blockquote) a:not([class]):hover{text-decoration-color:currentColor}
</style>
