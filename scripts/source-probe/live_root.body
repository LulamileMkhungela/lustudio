463 2.0625 7.10989 2.0625 7.00068C2.0625 6.89148 2.10588 6.78675 2.18311 6.70952C2.26032 6.6323 2.36506 6.58892 2.47426 6.58892H10.5392L7.53588 3.58612C7.45862 3.50886 7.41521 3.40407 7.41521 3.2948C7.41521 3.18553 7.45862 3.08074 7.53588 3.00348C7.61315 2.92621 7.71794 2.88281 7.82721 2.88281C7.93647 2.88281 8.04127 2.92621 8.11853 3.00348L11.8245 6.70936C11.8627 6.7476 11.8931 6.79301 11.9138 6.843C11.9345 6.89299 11.9452 6.94658 11.9452 7.00068C11.9452 7.0548 11.9345 7.10837 11.9138 7.15836C11.8931 7.20835 11.8627 7.25377 11.8245 7.29201Z" fill="#F5F5F5"></path></svg></div></div></div></div><div class="features_time-lines"><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div><div class="features_time-line"></div></div></div></div></div></div><div class="w-embed w-script"><style>.dx-ph{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:16px}.dx-ph-card{position:relative;border-radius:20px;min-height:380px;padding:28px 24px;background:#141517;border:1px solid rgba(255,255,255,.07);color:#fff;display:flex;flex-direction:column;justify-content:space-between;gap:40px;overflow:hidden;isolation:isolate;transition:border-color .4s}.dx-ph-card:before{content:"";position:absolute;width:260px;height:260px;right:-120px;top:-120px;border-radius:50%;z-index:-1;background:conic-gradient(from var(--cc-ba,0deg),#ff6ec4,#ffb35c,#7ad8ff,#8b7bff,#ff6ec4);filter:blur(70px);opacity:.14;transition:opacity .5s}.dx-ph-card:hover{border-color:rgba(255,255,255,.16)}.dx-ph-card:hover:before{opacity:.3}.dx-ph-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.dx-ph-num{font-size:13px;line-height:1;color:#8a8a8a;padding-top:4px}.dx-ph-ico{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;background:radial-gradient(circle at 30% 25%,rgba(255,255,255,.14),rgba(255,255,255,.03) 70%);border:1px solid rgba(255,255,255,.14)}.dx-ph-avs{display:flex;align-items:center}.dx-ph-avs img,.dx-ph-avs span{width:44px;height:44px;border-radius:50%;border:2px solid #141517;object-fit:cover;margin-left:-12px;background:#26282b;filter:grayscale(1)}.dx-ph-avs img:first-child{margin-left:0}.dx-ph-avs span{display:flex;align-items:center;justify-content:center;font-size:13px;color:#fff;filter:none}.dx-ph-card h3{font-size:24px;line-height:1.1;font-weight:500;letter-spacing:-.02em;margin:0 0 12px;color:#fff}.dx-ph-card p{font-size:15px;line-height:1.45;color:#a8a8a8;margin:0}@media (min-width:992px){.dx-ph-card{justify-content:flex-start;gap:72px}.dx-ph-card h3{min-height:2.2em;display:flex;align-items:flex-end}}@media (max-width:991px){.dx-ph{grid-template-columns:repeat(2,minmax(0,1fr))}.dx-ph-card{min-height:320px}}@media (max-width:767px){.dx-ph{grid-template-columns:1fr;gap:12px}.dx-ph-card{min-height:0;gap:28px;padding:24px 20px;border-radius:16px}.dx-ph-card h3{font-size:22px}.dx-ph-ico{width:52px;height:52px}.dx-ph-avs img,.dx-ph-avs span{width:40px;height:40px}}</style><div class="dx-ph" role="list"><div class="dx-ph-card dx-reveal" role="listitem"><div class="dx-ph-top"><div class="dx-ph-ico"><svg viewBox="0 0 24 24" fill="none" width="26" height="26" aria-hidden="true" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8 4 12l4 4M16 8l4 4-4 4M13.5 5l-3 14"/></svg></div><div class="dx-ph-num">01</div></div><div><h3>UI/UX engineers</h3><p>At Cosmos Studio, the people who design your product also build its front end, design system, and motion in code. We call it UI engineering: what you approve is what ships.</p></div></div><div class="dx-ph-card dx-reveal" role="listitem"><div class="dx-ph-top"><div class="dx-ph-avs" aria-label="Cosmos Studio team"><img src="/assets/img/valentyn.webp" alt="" loading="lazy" width="44" height="44"><img src="/assets/img/woman-1.webp-4.webp" alt="" loading="lazy" width="44" height="44"><img src="/assets/img/rostyslav.webp" alt="" loading="lazy" width="44" height="44"><img src="/assets/img/woman-1.webp.webp" alt="" loading="lazy" width="44" height="44"><img src="/assets/img/vova.webp" alt="" loading="lazy" width="44" height="44"><span>+5</span></div><div class="dx-ph-num">02</div></div><div><h3>Senior team only</h3><p>Every designer on client work has more than 5 years of product design experience, and every deliverable goes through art director review. We don’t place junior designers on client projects.</p></div></div><div class="dx-ph-card dx-reveal" role="listitem"><div class="dx-ph-top"><div class="dx-ph-ico"><svg viewBox="0 0 24 24" fill="none" width="26" height="26" aria-hidden="true" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="5"/><path d="m9 13.5-1.5 7L12 18l4.5 2.5-1.5-7"/><path d="m12 6.6.8 1.6 1.7.2-1.2 1.2.3 1.7-1.6-.8-1.6.8.3-1.7-1.2-1.2 1.7-.2z"/></svg></div><div class="dx-ph-num">03</div></div><div><h3>Awarded and jury-led</h3><p>60+ international design awards, including 18 Awwwards, 25 CSS Design Awards, three FWA of the Day awards, and a Red Dot Award. Our founder serves on the Awwwards jury.</p></div></div><div class="dx-ph-card dx-reveal" role="listitem"><div class="dx-ph-top"><div class="dx-ph-ico"><svg viewBox="0 0 24 24" fill="none" width="26" height="26" aria-hidden="true" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/><path d="m4 8 6-4 6 7 5-4"/></svg></div><div class="dx-ph-num">04</div></div><div><h3>Decisions based on your data</h3><p>We start from your customers, your metrics, and how people really use the product. Customer interviews follow The Mom Test method, screens follow Nielsen Norman Group heuristics and WCAG, and after launch we track results in analytics.</p></div></div></div><script>(function(){if(!matchMedia("(max-width:479px)").matches)return;var c=document.querySelector(".home-grid_chat");if(!c||!window.IntersectionObserver)return;var q=function(s){return c.querySelector(s)},P=q(".chat_pic._2"),S=[[".chat_message._2",".chat_spacing._1"],[".chat_spacing._2"],[".home-grid_chat-group._2",".chat_message._4"],[".chat_message._5",".chat_spacing._3"]],D=[900,700,1100,900],E=[],H=[],busy=0;S.forEach(function(g){g.forEach(function(s){var e=q(s);if(e){E.push(e);H.push(e.offsetHeight)}})});function hide(){E.forEach(function(e){e.style.overflow="hidden";e.style.transition="none";e.style.height="0px"});if(P){P.style.transition="none";P.style.transform="scale(0)"}}function show(g){g.forEach(function(s){var e=q(s),i=E.indexOf(e);if(e){e.style.transition="height .3s ease";var h=H[i];if(s==".home-grid_chat-group._2"){h-=(H[E.indexOf(q(".chat_message._5"))]||0)+(H[E.indexOf(q(".chat_spacing._3"))]||0)}e.style.height=h+"px";setTimeout(function(){e.style.height=""},350)}});if(g[0]==".home-grid_chat-group._2"&&P){P.style.transition="transform .3s ease";P.style.transform="scale(1)"}}function play(){if(busy)return;busy=1;hide();var t=0;S.forEach(function(g,i){t+=D[i];setTimeout(function(){show(g)},t)});setTimeout(function(){busy=0},t+400)}hide();new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting)play()})},{threshold:.35}).observe(c);})();</script></div></div></div><div class="padding-section-medium is-tablet-small"></div></div></div></div></section><section class="section_blog-list"><div class="padding-section-medium"></div><div class="padding-global"><div class="container-large"><div class="blog-list_component"><div class="container-xxsmall"><div class="works_head"><div class="text-color-grey-300"><div class="text-style-label-caption">Blog</div></div><div class="spacer-small"></div><div class="text-align-center"><h2 class="heading-style-h2">Insights on AI, product design and defense tech</h2></div></div></div><div class="spacer-large"></div><div class="blog_wrapper-v3 w-dyn-list"><div role="list" class="blog_list-v3 keen-slider w-dyn-items"><div role="listitem" class="blog_item-v3 keen-slider__slide w-dyn-item"><a href="/blog/canva-video-claude-chatgpt-gemini-mac-tesla-reality-view" class="blog_block with-gap w-inline-block"><div class="blog_img-wrap"><img animation="scroll-zoom" loading="lazy" alt="AI &amp; Design Weekly #10 cover, &quot;AI moves into your other tools&quot;: a chat with a video plan, a background agent window on a Mac, Standby and Approve controls and a car path preview" src="/_m/native/blog/digest10-cover.webp" class="blog_img"/></div><div class="blog_content-v3"><div class="blog-card_content"><div class="author-block"><img loading="lazy" src="/assets/img/avatar.webp" alt="" class="author_thumbn"/><div class="author-small">Illia Kulbachnyi</div></div><div class="blog_content-in"><h3 class="heading-style-h5 is-tablet-xsmaller">Canva video in Claude and ChatGPT, Gemini on your Mac, Tesla Reality View – AI &amp; Design Weekly #10</h3><p class="blog_desc">Canva MCP goes GA with video in Claude and ChatGPT, Gemini uses your Mac, Tesla starts rolling out Reality View, GPT-Live-1.1 API, Inkling 2 Mini, Signal, Agon. Nov 19–24, 2026.</p></div></div><div class="text-color-grey-300"><div class="blog-date">November 24, 2026</div></div></div></a><div fs-list-field="DATE" class="hidden">2026-11-24</div><div fs-list-field="industry" class="hidden w-dyn-bind-empty"></div></div><div role="listitem" class="blog_item-v3 keen-slider__slide w-dyn-item"><a href="/blog/pitch-deck-design-services" class="blog_block with-gap w-inline-block"><div class="blog_img-wrap"><img animation="scroll-zoom" loading="lazy" alt="Pitch deck design services in 2026 – cover: a send-ahead deck of ten slides with the first three highlighted, 44% of investors reaching the last slide per Papermark 2026, and a price chip from $1,000 for up to 20 slides in about one week" src="/_m/native/blog/pitch-deck-design-services/cover-v2.webp" class="blog_img"/></div><div class="blog_content-v3"><div class="blog-card_content"><div class="author-block"><img loading="lazy" src="/assets/img/avatar.webp" alt="" class="author_thumbn"/><div class="author-small">Illia Kulbachnyi</div></div><div class="blog_content-in"><h3 class="heading-style-h5 is-tablet-xsmaller">Pitch deck design services in 2026: cost, timelines and what investors actually read</h3><p class="blog_desc">Pitch deck design services in 2026: vendor prices, what a $1,000 deck includes, how long investors read (Papermark, DocSend) and 8 rules we design by.</p></div></div><div class="text-color-grey-300"><div class="blog-date">November 23, 2026</div></div></div></a><div fs-list-field="DATE" class="hidden">2026-11-23</div><div fs-list-field="industry" class="hidden w-dyn-bind-empty"></div></div><div role="listitem" class="blog_item-v3 keen-slider__slide w-dyn-item"><a href="/blog/gpt-6-2-astra-sol-gemini-4-neon-microsoft-today" class="blog_block with-gap w-inline-block"><div class="blog_img-wrap"><img animation="scroll-zoom" loading="lazy" alt="AI &amp; Design Weekly #9 cover, &quot;AI that gets work ready before you ask&quot;: a morning brief card with Approve and Edit, model cards for GPT-6.2 Sol and Gemini 4 Neon, a Genie 4 world card and a verified chip design rewrite" src="/assets/img/digest09-cover.webp" class="blog_img"/></div><div class="blog_content-v3"><div class="blog-card_content"><div class="author-block"><img loading="lazy" src="/assets/img/avatar.webp" alt="" class="author_thumbn"/><div class="author-small">Illia Kulbachnyi</div></div><div class="blog_content-in"><h3 class="heading-style-h5 is-tablet-xsmaller">GPT-6.2 Astra and Sol, Gemini 4 Neon, Microsoft Today – AI &amp; Design Weekly #9</h3><p class="blog_desc">GPT-6.2 Astra and Sol, Gemini 4 Neon, MAI Image 2.7 and Canvas, Microsoft Today, Genie 4, AI chip design at AMD, ICEYE bids for Avio: November 17–20, 2026.</p></div></div><div class="text-color-grey-300"><div class="blog-date">November 20, 2026</div></div></div></a><div fs-list-field="DATE" class="hidden">2026-11-20</div><div fs-list-field="industry" class="hidden w-dyn-bind-empty"></div></div></div></div><div class="spacer-large"></div><div class="button-center"><a data-wf--button--variant="medium-light" href="/blog" class="button w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 w-inline-block"><div class="button-in w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57"><div class="button_texts w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57"><div class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _1">Show more</div><div aria-hidden="true" class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _2">Show more</div></div><div class="button_glow-wrap"><div class="button_glow"></div></div></div><div class="button_border-wrap"><div class="button_border"></div></div></a></div></div></div></div><div class="padding-section-medium"></div></section><div class="w-embed w-script"><section class="section_faq dx-faq"><div class="padding-section-small"></div><div class="padding-global"><div class="works_head"><div class="text-color-grey-250"><div class="text-style-label-caption">FAQ</div></div><div class="spacer-small"></div><div class="text-align-center container-xsmall"><h2>Frequently asked questions</h2></div><div class="spacer-xlarge"></div></div><div class="container-large"><div class="faq_component"><div class="faq_content"><div class="faq_list"><div class="faq_list"><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>1</div></div><h3 class="faq_question">What does a UI/UX design studio do?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>A UI/UX design studio designs how a digital product works and looks: research, user flows, interface design, and a design system.</p><p>Cosmos Studio also builds the front end in React and Next.js, so the same team takes your product from the first customer interview to working code.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>2</div></div><h3 class="faq_question">How much does UI/UX design cost?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Projects start at $5,000, with hourly rates from $50. Specialized senior roles, such as AWS cloud architects, can cost up to $170 per hour.</p><p>After the discovery call, you get a free, non-binding estimate based on the confirmed scope. For a quick range, try our <a href="/pricing">project cost calculator</a>.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>3</div></div><h3 class="faq_question">How long does a project take?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>A typical project takes 2–6 weeks. A landing page takes 1–2 weeks, a brand identity 1–3 weeks, a multi-page CMS website 2–4 weeks, MVP app design 3–4 weeks (4–8 weeks with front-end development), and a UX audit 1–2 weeks.</p><p>Larger products are delivered in stages, so your developers can start before the whole design is finished.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>4</div></div><h3 class="faq_question">How do we start working together?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Book a discovery call. We learn about your product, customers, and goals, and you can ask for an NDA from the first call.</p><p>Then we agree on scope, deliverables, and price before any work starts.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>5</div></div><h3 class="faq_question">Why do you start with research?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Because design built on guesses is expensive to fix later. If you already know your customers’ needs, we go straight to product hypotheses.</p><p>If not, we run customer interviews using The Mom Test method, or give you the questions to ask your customers.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>6</div></div><h3 class="faq_question">What does working with you look like week to week?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>You see the first results within a week of kickoff. Designs and staging builds are reviewed every week, and nothing moves to the next stage without your sign-off.</p><p>Day-to-day questions go through Slack or WhatsApp. The team works 10:00–18:00 Kyiv time, which overlaps with US East Coast mornings.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>7</div></div><h3 class="faq_question">Who will work on my project?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>A dedicated senior team: a product or UI/UX designer and a project manager as your single point of contact. Our design director Alex Chaika reviews every deliverable, and founder Illia Kulbachnyi joins reviews of key stages.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>8</div></div><h3 class="faq_question">Do you also develop the product?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Yes. We build production front ends in React, Next.js, and TypeScript, and websites on Webflow, WordPress, or custom code.</p><p>Backend, mobile apps, and cloud are delivered by our vetted senior engineering partners under the same contract.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>9</div></div><h3 class="faq_question">Can you work with our in-house team?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Yes. Our designers can join your sprints as an embedded design team, or hand off a design system and code to your developers.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>10</div></div><h3 class="faq_question">Which industries do you work with?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Defense and military tech, SaaS, AI products, EdTech, MedTech and healthcare, Web3, gaming, B2B and IT services, hospitality, health and wellness, and nonprofits.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>11</div></div><h3 class="faq_question">Can you work under an NDA?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Yes. Every project can operate under an NDA from the first call.</p></div></div></div><div class="faq_accordion"><div class="faq_question-block"><div class="faq_question-wrap"><div class="faq_number-wrap"><div>12</div></div><h3 class="faq_question">Can we talk to your past clients?</h3></div><div class="faq_button"><div class="faq_button-line"></div><div class="faq_button-line is-second"></div></div></div><div class="faq_answer-wrap"><div class="faq_answer-spacing"></div><div class="faq_answer"><p>Yes. We share client contacts for references on request. You can also read 21 verified reviews on our <a href="https://clutch.co/profile/cosmos-studio" target="_blank" rel="noopener">Clutch profile</a> and contact the reviewers there.</p></div></div></div></div><div class="faq_infos-block"><div class="faq_talk-link"><div class="faq_info-texts"><h3 class="heading-style-h5">Still got questions?</h3><div class="spacer-small"></div><div class="text-size-regular">If yours isn’t here, ask our Business Developer Anna on the call.</div></div></div><a data-wf--button--variant="medium-light" href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ2rm7eGeBjNfb8kLSodGTte3bMJ7H6xE2BJeRxG8x4fq-pLf1bry8ghqQoI4vwfJiX3K7NtmpQR" target="_blank" rel="noopener" class="button w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 w-inline-block"><div class="button-in w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57"><div class="button_texts w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57"><div class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _1">Book a Discovery Call</div><div aria-hidden="true" class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _2">Book a Discovery Call</div></div><div class="button_glow-wrap"><div class="button_glow"></div></div></div><div class="button_border-wrap"><div class="button_border"></div></div></a></div></div></div></div></div></div><div class="padding-section-small"></div></section><script src="/_m/res.cloudinary.com/wtugnojd/raw/upload/v1791961262/dx/dx-v2.js" defer></script></div><div class="w-embed"><!-- ASK-AI block: added 2026-10-26, remove this embed to roll back. Logos: self-hosted in Webflow assets since 2026-11-19 (Wikimedia hotlinks were rate-limited) -->
<style>.ask-ai_grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-width:880px;margin:0 auto}
.ask-ai_card{display:flex;flex-direction:column;gap:4px;padding:20px;background:#fff;border:1px solid #ddd;border-radius:8px;color:#0f1011;text-decoration:none;transition:border-color .25s ease,transform .25s ease,box-shadow .25s ease}
.ask-ai_card:hover{border-color:#0f1011;transform:translateY(-2px);box-shadow:0 8px 24px rgba(15,16,17,.06)}
.ask-ai_card:focus-visible{outline:2px solid #0f1011;outline-offset:2px}
.ask-ai_top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px}
.ask-ai_logo{display:block;width:28px;height:28px;overflow:hidden}
.ask-ai_logo img{display:block;width:28px;height:28px;object-fit:contain}
.ask-ai_logo.is-crop img{width:auto;max-width:none;height:28px}
.ask-ai_arrow{width:16px;height:16px;color:#9a9a9a;transition:color .25s ease,transform .25s ease}
.ask-ai_card:hover .ask-ai_arrow{color:#0f1011;transform:translate(2px,-2px)}
.ask-ai_name{font-size:18px;line-height:1.3;font-weight:500}
.ask-ai_sub{font-size:14px;line-height:1.4}
@media screen and (max-width:767px){.ask-ai_grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ask-ai_top{margin-bottom:20px}}</style>
