6f705ac57"><div class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _1">Show more</div><div aria-hidden="true" class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _2">Show more</div></div><div class="button_glow-wrap"><div class="button_glow"></div></div></div></a></div></div></div></div><div role="listitem" class="service-sticky w-dyn-item"><div data-wf--home-services_item--variant="base" class="home-services_item"><div class="line-2 is-darker"></div><div class="home-services_item-in"><div class="home-services_examples"><div class="home-services_item-head"><div class="home-services_number"><div>12</div></div><h3 class="home-services_title">Hospitality and Travel</h3></div><div class="home-services_services"><div class="tag-text w-richtext"><p>Brand identity</p><p>Hospitality</p><p>Travel</p><p>Private club</p><p>Hotel</p><p>Website</p></div></div><div class="service-button_desktop"><a data-wf--button--variant="small-light" href="/industries/hospitality-travel" class="button w-inline-block"><div class="button-in"><div class="button_texts"><div class="button_text _1">Show more</div><div aria-hidden="true" class="button_text _2">Show more</div></div><div class="button_glow-wrap"><div class="button_glow"></div></div></div></a></div></div><div class="home-services_desc"><div class="home-services_img-wrap"><img loading="lazy" src="/assets/img/opt-6ac4aeea832d994399fd13d3.webp" alt="The 23 private members club brand identity by Cosmos Studio" class="home-services_img"/></div><div class="home-services_text-wrap"><p class="text-color-grey-300-2">Hospitality branding agency for hotels, private clubs, and travel platforms. Brand identity, booking-ready websites, and print from one senior team.</p></div></div><div class="service-button_mobile"><a data-wf--button--variant="medium-light" href="/industries/hospitality-travel" class="button w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 w-inline-block"><div class="button-in w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57"><div class="button_texts w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57"><div class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _1">Show more</div><div aria-hidden="true" class="button_text w-variant-9cb96ae5-a355-784d-c2ef-0196f705ac57 _2">Show more</div></div><div class="button_glow-wrap"><div class="button_glow"></div></div></div></a></div></div></div></div></div></div></div></div></div></div></div></div></div><div class="padding-section-small"></div></div></div></section><section class="section_about"><div class="padding-section-medium"></div><div class="padding-global is-tiny"><div class="container-large"><div class="about_component"><div class="about_content"><div class="about_content-main"><div class="text-color-grey-300"><div class="text-style-label-caption">About us</div></div><div class="spacer-small"></div><h2 class="heading-style-h3 is-mobile-h4">A boutique design team that turns ideas into powerful digital experiences</h2><div class="spacer-custom-2"></div><p class="about_paragraph">We&#x27;re not a freelancer who disappears after delivery. Not a 200-person agency where you&#x27;ll never meet a senior. We&#x27;re a boutique, embedded design team and the longer we work together, the sharper we get.</p><div class="spacer-medium"></div></div><div class="about_items"><div class="about_item"><div class="about_lottie" data-w-id="4c18b827-b20c-1e1d-1997-95cc5621e935" data-animation-type="lottie" data-src="/assets/data/globe.json" data-loop="1" data-direction="1" data-autoplay="1" data-is-ix2-target="0" data-renderer="svg" data-default-duration="2" data-duration="0" data-loading="eager"></div><div class="about_item-texts"><h3 class="about_item-title">Europe based</h3><div class="text-color-grey-300"><p class="text-size-small text-weight-medium">Remote-friendly team growing fast</p></div></div></div><div class="about_item"><div class="about_lottie big" data-w-id="4c18b827-b20c-1e1d-1997-95cc5621e93d" data-animation-type="lottie" data-src="/assets/data/loading-icon-dot-orbit.lottie" data-loop="1" data-direction="1" data-autoplay="1" data-is-ix2-target="0" data-renderer="svg" data-default-duration="0" data-duration="1.3333333333333333" data-loading="eager"></div><div class="about_item-texts"><h3 class="about_item-title">Senior team, lasting results</h3><div class="text-color-grey-300"><p class="text-size-small text-weight-medium">We focus on quality over quantity</p></div></div></div></div></div><div id="w-node-_4c18b827-b20c-1e1d-1997-95cc5621e944-5621e91f" data-w-id="4c18b827-b20c-1e1d-1997-95cc5621e944" class="home-grid_team"><div class="team-heading"><h3 class="home-grid_team-heading">Real humans, amplified with AI</h3><div class="text-style-label-caption">Senior taste, AI speed</div></div><div class="home-grid_circle-1"><img loading="lazy" src="/assets/img/woman-1.webp-4.webp" alt="Cosmos Studio team member" class="home-grid_member _1"/><img loading="lazy" src="/assets/img/woman-1.webp.webp" alt="Cosmos Studio team member" class="home-grid_member _2"/><img loading="lazy" src="/assets/img/woman-1.webp-3.webp" alt="Cosmos Studio team member" class="home-grid_member _4"/><img loading="lazy" src="/assets/img/woman-1.webp-1.webp" alt="Cosmos Studio team member" class="home-grid_member _5"/></div><div class="home-grid_circle-2"><img loading="lazy" src="/assets/img/valentyn.webp" alt="Valentyn, Cosmos Studio team member" class="home-grid_member-in _4"/><img loading="lazy" src="/assets/img/woman-4.webp-1.webp" alt="Cosmos Studio team member" class="home-grid_member-in _6"/><img loading="lazy" src="/assets/img/woman-4.webp-2.webp" alt="Cosmos Studio team member" class="home-grid_member-in _1"/><img loading="lazy" src="/assets/img/vova.webp" alt="Vova, Cosmos Studio team member" class="home-grid_member-in _5"/><img loading="lazy" src="/assets/img/woman-4.webp.webp" alt="Cosmos Studio team member" class="home-grid_member-in _2"/><img loading="lazy" src="/assets/img/rostyslav.webp" alt="Rostyslav, Cosmos Studio team member" class="home-grid_member-in _3"/></div><canvas id="space" class="space-canvas"></canvas></div></div></div></div><div class="padding-section-medium"></div></section><section class="section_home-services"><div class="padding-global is-tiny"><div class="home-services_component"><div class="padding-global"><div class="padding-section-medium is-mobile-xsmall"></div><div class="container-large"><div class="features_component"><div class="text-color-grey-250"><div class="text-style-label-caption center">Why choose us</div></div><div class="spacer-small"></div><div class="max-width-xxlarge"><div class="text-color-white"><div class="text-align-center"><h2 class="heading-style-h2">A UI/UX design studio that designs and builds your product</h2></div></div></div><div class="spacer-custom-2"></div><p class="features_desc">Senior designers who also write front-end code, weekly reviews, and one point of contact from the first call to launch.</p><div class="spacer-medium"></div><a data-wf--button--variant="medium-dark" href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ2rm7eGeBjNfb8kLSodGTte3bMJ7H6xE2BJeRxG8x4fq-pLf1bry8ghqQoI4vwfJiX3K7NtmpQR" target="_blank" class="button w-variant-d9d324ad-6eea-9151-add1-8c3731ed28fa w-inline-block"><div class="button-in w-variant-d9d324ad-6eea-9151-add1-8c3731ed28fa"><div class="button_texts"><div class="button_text w-variant-d9d324ad-6eea-9151-add1-8c3731ed28fa _1">Book a Call</div><div aria-hidden="true" class="button_text w-variant-d9d324ad-6eea-9151-add1-8c3731ed28fa _2">Talk to us</div></div><div class="button_glow-wrap"><div class="button_glow w-variant-d9d324ad-6eea-9151-add1-8c3731ed28fa"></div></div></div><div class="button_border-wrap"><div class="button_border w-variant-d9d324ad-6eea-9151-add1-8c3731ed28fa"></div></div></a><div class="spacer-xxlarge"></div><div class="features_grid"><div class="features_sync"><img src="/assets/img/feature-1.webp" loading="lazy" sizes="(max-width: 1600px) 100vw, 1600px" srcset="/assets/img/feature-1-p-500.webp 500w, /assets/img/feature-1-p-800.webp 800w, /assets/img/feature-1-p-1080.webp 1080w, /assets/img/feature-1.webp 1600w" alt="Large sand dune with a sharp crest under a clear sky." class="features_sync-img"/><div class="features_calendar"><div class="features_calendar-dates-wrap"><img src="/assets/img/calendar.svg" loading="lazy" alt="" class="features_calendar-dates"/><div class="features_person-wrap _1"><img src="/assets/img/calendar-person-1.webp" loading="lazy" alt="Smiling young man with black hair wearing a black shirt against a gray background." class="features_person"/><div class="features_touch _1"></div></div><div class="features_person-wrap _2"><img src="/assets/img/calendar-person-2.png" loading="lazy" alt="Portrait of a woman with dark hair pulled back, wearing natural makeup and a neutral expression." class="features_person"/><div class="features_touch _2"></div></div><div class="features_person-wrap _3"><img src="/assets/img/calendar-person-3.png" loading="lazy" alt="Person with dreadlocks covering lower face with maroon sweater, looking intently at the camera." class="features_person"/><div class="features_touch _3"></div></div></div><div class="features_meetings"><div class="features_meeting-in _1"><div class="features_meeting-group"><div class="features_meeting"><div class="features_time">8:30 AM</div><div class="features_infos"><div class="features_meet-info">Kickoff call with</div><img src="/assets/img/calendar-person-1.webp" loading="lazy" alt="Smiling young man with black hair wearing a black shirt against a gray background." class="features_person-2"/><div class="features_user">@Jaeho Park</div></div></div><div class="features_meeting"><div class="features_time">10 AM</div><div class="features_infos"><div class="features_meet-info">Brainstorm session</div></div></div></div></div><div class="features_meeting-in _2"><div class="features_meeting-group"><div class="features_meeting"><div class="features_time">10:30 AM</div><div class="features_infos"><div class="features_meet-info">Updates and track with</div><img src="/assets/img/calendar-person-2.png" loading="lazy" alt="Portrait of a woman with dark hair pulled back, wearing natural makeup and a neutral expression." class="features_person-2"/><div class="features_user">@Elise M.</div></div></div><div class="features_meeting"><div class="features_time">2 PM</div><div class="features_infos"><div class="features_meet-info">Wireframes presentation</div></div></div></div></div><div class="features_meeting-in _3"><div class="features_meeting-group"><div class="features_meeting"><div class="features_time">11 AM</div><div class="features_infos"><div class="features_meet-info">Strategic design</div><img src="/assets/img/calendar-person-3.png" loading="lazy" alt="Person with dreadlocks covering lower face with maroon sweater, looking intently at the camera." class="features_person-2"/><div class="features_user">@Daniel Brooks</div></div></div><div class="features_meeting"><div class="features_time">5 PM</div><div class="features_infos"><div class="features_meet-info">Branding presentation</div></div></div></div></div></div></div><div class="features_sync-texts"><h4 class="features_heading">Weekly syncs</h4><p class="features_subheading">Every week, we align on priorities, review progress, and keep strategy sharp.</p></div><div class="features_gradient-sync"></div></div><div class="features_column"><div class="chatanim"><div data-w-id="bc9f34be-b268-1ee3-d18d-8fa2c3e02cb8" class="home-grid_chat"><div class="codeblock w-embed w-script"><script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('[data-split]').forEach(function (el) {
    var max = parseInt(el.getAttribute('data-split'), 10) || 24;
    var text = el.dataset.splitSource || (el.dataset.splitSource = el.textContent.trim());
    var lines = [], line = '';

    text.split(/\s+/).forEach(function (word) {
      if (!line) line = word;
      else if ((line + ' ' + word).length <= max) line += ' ' + word;
      else { lines.push(line); line = word; }
    });
    if (line) lines.push(line);

    el.textContent = '';
    lines.forEach(function (l, i) {
      if (i) el.appendChild(document.createElement('br'));
      el.appendChild(document.createTextNode(l));
    });
  });
});
</script></div><div class="home-grid_label">Real-time collaboration</div><div class="home-grid_chat-in"><div class="home-grid_chat-group _1"><div class="home-grid_chats"><div class="chat_message _1"><div class="home-grid_message"><p class="home-grid_message-text">Hey!</p></div></div><div class="chat_spacing _1"></div><div class="chat_message _2"><div class="home-grid_message"><p data-split="" class="home-grid_message-text _1">We need a mobile app for clinicians. Very data-heavy</p></div></div><div class="chat_spacing _2"></div></div></div><div class="home-grid_chat-group _2"><div class="home-grid_chats _2"><div class="chat_message _4"><div class="home-grid_message"><p class="home-grid_message-text _2">Hi Philip!</p></div></div><div class="chat_spacing _3"></div><div class="chat_message _5"><div class="home-grid_message"><p data-split="" class="home-grid_message-text _3">We&#x27;ve worked in MedTech <br/>before. What&#x27;s the compliance situation?</p></div></div></div><img loading="lazy" src="/assets/img/profile-picture.webp" alt="Anna Shestakova, Business Developer at Cosmos Studio" class="chat_pic _2"/></div></div></div></div><div data-lazyload="" data-video="" class="red-dot"><video playsinline="true" muted="" loop="" preload="none" data-poster="/assets/img/a-red-metallic_poster.0000000.jpg" data-src="https://video.cosmos.studio/wf/6a2d7cbbf789986bf2972fa2_A%20red%20metallic_mp4.mp4" class="red-dot_vid"></video><div class="features_heading">60+ international<br/>Design Awards</div><div class="custom-play"><button class="play-pause"><span data-state="play" class="video-button"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="player-icon pause"><path d="M5 15.3333V4.66663C5 4.39048 5.22386 4.16663 5.5 4.16663H7.83333C8.10947 4.16663 8.33333 4.39048 8.33333 4.66663V15.3333C8.33333 15.6095 8.10947 15.8333 7.83333 15.8333H5.5C5.22386 15.8333 5 15.6095 5 15.3333Z" fill="currentColor" stroke="currentColor" stroke-width="1.5"></path><path d="M11.6667 15.3333V4.66663C11.6667 4.39048 11.8906 4.16663 12.1667 4.16663H14.5001C14.7762 4.16663 15.0001 4.39048 15.0001 4.66663V15.3333C15.0001 15.6095 14.7762 15.8333 14.5001 15.8333H12.1667C11.8906 15.8333 11.6667 15.6095 11.6667 15.3333Z" fill="currentColor" stroke="currentColor" stroke-width="1.5"></path></svg></span><span data-state="pause" class="video-button"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="player-icon play"><path d="M7.80982 4.10849C7.48193 3.84963 7 4.08318 7 4.50093V14.9374C7 15.3552 7.48193 15.5887 7.80982 15.3298L14.4196 10.1116C14.6732 9.91141 14.6732 9.52691 14.4196 9.32674L7.80982 4.10849Z" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></button></div></div></div><div id="w-node-_0a62ecc4-5f80-8eb1-4336-7d525cfd03dd-e651e8e2" class="features_timeline"><div class="features_timeline-head"><div class="features_timeline-heading">Timeline &amp; Process</div><div class="features_timeline-data"><div class="features_experts"><div class="features_timeline-texts hide-small-screen">+8 experts</div><div class="features_members"><img src="/assets/img/member-1.webp" loading="lazy" alt="Portrait of a woman with short dark hair wearing a beige blazer against a neutral background." class="features_member"/><img src="/assets/img/member-2.webp" loading="lazy" alt="Side profile of a young person wearing a beige baseball cap and a black jacket with a white collar against a plain background." class="features_member _2"/><img src="/assets/img/member-3.webp" loading="lazy" alt="Smiling man with short curly brown hair wearing a dark maroon turtleneck against a beige background." class="features_member _3"/></div></div><div class="features_date"><div aria-hidden="true" class="features_date-icon-wrap"><img src="/assets/img/calendar-white.svg" loading="lazy" alt="" class="features_date-icon"/></div><div class="features_data-line"></div><div class="features_date-text-wrap"><div class="features_date-text">Project time: 8 weeks</div></div></div></div></div><div class="features_time-wrapper"><div class="features_time-wrap"><div class="features_time-rows"><div class="features_time-row order-1"><div id="w-node-_0a62ecc4-5f80-8eb1-4336-7d525cfd03f4-e651e8e2" class="features_time-block"><div class="features_time-number">01</div><div class="timeline_text"><div class="features_timeline-texts">Discovery</div><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 14 14" fill="none" class="timeline_arrow"><path d="M11.8245 7.29201L8.11853 10.9979C8.04127 11.0752 7.93647 11.1186 7.82721 11.1186C7.71794 11.1186 7.61315 11.0752 7.53588 10.9979C7.45862 10.9207 7.41521 10.8158 7.41521 10.7065C7.41521 10.5973 7.45862 10.4925 7.53588 10.4153L10.5392 7.41245H2.47426C2.36506 7.41245 2.26032 7.36907 2.18311 7.29185C2.10588 7.21463 2.0625 7.10989 2.0625 7.00068C2.0625 6.89148 2.10588 6.78675 2.18311 6.70952C2.26032 6.6323 2.36506 6.58892 2.47426 6.58892H10.5392L7.53588 3.58612C7.45862 3.50886 7.41521 3.40407 7.41521 3.2948C7.41521 3.18553 7.45862 3.08074 7.53588 3.00348C7.61315 2.92621 7.71794 2.88281 7.82721 2.88281C7.93647 2.88281 8.04127 2.92621 8.11853 3.00348L11.8245 6.70936C11.8627 6.7476 11.8931 6.79301 11.9138 6.843C11.9345 6.89299 11.9452 6.94658 11.9452 7.00068C11.9452 7.0548 11.9345 7.10837 11.9138 7.15836C11.8931 7.20835 11.8627 7.25377 11.8245 7.29201Z" fill="#F5F5F5"></path></svg></div></div></div><div class="features_time-row order-2"><div id="w-node-_0a62ecc4-5f80-8eb1-4336-7d525cfd03fa-e651e8e2" class="features_time-block"><div class="timeline_text"><div class="features_timeline-texts">UX Design</div><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 14 14" fill="none" class="timeline_arrow"><path d="M11.8245 7.29201L8.11853 10.9979C8.04127 11.0752 7.93647 11.1186 7.82721 11.1186C7.71794 11.1186 7.61315 11.0752 7.53588 10.9979C7.45862 10.9207 7.41521 10.8158 7.41521 