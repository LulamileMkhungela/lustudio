      },
      "description": "UI/UX design and development studio for SaaS, AI, defense, and military tech. One senior team handles research, UX, UI, design systems, and front-end development in React and Next.js.",
      "email": "hello@cosmos.studio",
      "founder": {
        "@id": "https://www.cosmos.studio/#founder"
      },
