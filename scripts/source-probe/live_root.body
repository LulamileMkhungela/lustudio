@supports (appearance: base-select) {
  /* opt both the control and its picker into base styles */
  .dropdown.w-select,
  .dropdown.w-select::picker(select) {
    appearance: base-select;
  }

  .dropdown.w-select {
  display: flex;
  align-items: center;      
  gap: 0.5rem;
}
  .dropdown.w-select selectedcontent {
  flex: 1;
}

.dropdown.w-select::picker-icon {
  flex: none;
  width: 1.25rem;
  height: 1.25rem;
  content: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 7.5L10 12.5L15 7.5" stroke="%230F1011" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>');
  transition: transform .2s ease;
}
.dropdown.w-select:open::picker-icon {
  transform: rotate(180deg);
}
  /* the popup panel */
  .dropdown.w-select::picker(select) {
    border: 1px solid var(--_colors---grey--100);
    border-radius: var(--border-radius--medium);
    background-color: var(--_colors---primary--white);
    margin-top: .5rem;
    overflow: hidden;
  }

  /* individual options */
  .dropdown.w-select option {
    padding: var(--fixed--1-125rem) var(--fixed--1-25rem);
    border-bottom: 1px solid var(--_colors---grey--100);
    margin-bottom: -1px;
    cursor: pointer;
  }
  .dropdown.w-select option:hover,
  .dropdown.w-select option:focus { background: var(--_colors---grey--75); outline: none; }
  .dropdown.w-select option:checked { background: var(--_colors---grey--100) }
  .dropdown.w-select option::checkmark { order: 1; margin-left: auto; }
}

.dropdown.w-select option::checkmark {
  display: none;
}

  .dropdown.w--open .dropdown_icon {transform: rotate(180deg);}
  .dropdown_icon {transition: transform .2s ease;}
  

.blog_block:hover .blog_img {transform: scale(1.05);}

